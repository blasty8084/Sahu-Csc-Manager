# ─────────────────────────────────────────────────────────────────────────────
#  SAHU CSC — Render Environment Variables Reference
#  Copy the values you need into:
#    Render Dashboard → your service → Environment → Add Environment Variable
#
#  Secrets (marked with *) must be set manually — render.yaml sets sync: false.
#  Variables with a default value in render.yaml are already set via Blueprint.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
LOG_LEVEL=info
ALLOW_NON_INDIA=true

# ── Database * ────────────────────────────────────────────────────────────────
# neon.tech → your project → Connection Details → Connection string
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=5

# ── Session * ─────────────────────────────────────────────────────────────────
# Auto-generated by Render Blueprint (generateValue: true).
# For manual setup: openssl rand -hex 48
SESSION_SECRET=

# ── Admin accounts * ──────────────────────────────────────────────────────────
# Used by startup-init.ts to create accounts automatically on first boot.
# Change these to strong passwords before first deploy.
ADMIN_PASSWORD=your-strong-admin-password
OPERATOR_PASSWORD=your-strong-operator-password

# Optional contact details for seeded accounts
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=9876543210
OPERATOR_EMAIL=operator@sahucsc.in
OPERATOR_MOBILE=9876543211

# ── CORS * ────────────────────────────────────────────────────────────────────
# Set to your frontend URL (Vercel / custom domain).
# Supports comma-separated multiple origins: https://a.com,https://b.com
CORS_ORIGIN=https://your-frontend.vercel.app

# ── Business info ─────────────────────────────────────────────────────────────
BUSINESS_NAME=SAHU CSC Center
BUSINESS_ADDRESS=Main Road, Bargarh, Odisha 768028

# ── Email (Resend HTTP API) * ─────────────────────────────────────────────────
# resend.com → API Keys → Create API Key → copy key (re_xxx...)
# Verified domain: sahucsc.dpdns.org
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SAHU CSC <info@sahucsc.dpdns.org>
VAPID_EMAIL=mailto:sahuuttam690@gmail.com

# ── Backblaze B2 * ────────────────────────────────────────────────────────────
# backblaze.com → B2 Cloud Storage → Application Keys → Add New Key
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=SAHUCSCV2
# Plain hostname OR full https:// URL — both accepted
B2_BUCKET_ENDPOINT=s3.us-west-004.backblazeb2.com

# ── Upstash Redis * ───────────────────────────────────────────────────────────
# upstash.com → your database → REST API tab
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# ── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
MAXMIND_LICENSE_KEY=
