# ══════════════════════════════════════════════════════════
#  SAHU CSC — Render Environment Variables
#  Copy each key+value into:
#  Render Dashboard → your service → Environment → Add Env Var
#
#  🔒 = secret  (use "Secret Files" or mark as secret in Render)
#  ✏️  = fill in your own value before pasting
#  ✅  = already correct, paste as-is
# ══════════════════════════════════════════════════════════


# ── Server ────────────────────────────────────────────────
NODE_ENV=production                        # ✅
PORT=10000                                 # ✅ Render free tier default


# ── Database ──────────────────────────────────────────────
# Get from: neon.tech → your project → Dashboard → Connection String
# 🔒 ✏️
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require


# ── Session ───────────────────────────────────────────────
# Generate a strong random string: openssl rand -base64 48
# OR let render.yaml auto-generate it (generateValue: true)
# 🔒 ✏️
SESSION_SECRET=


# ── Admin Accounts ────────────────────────────────────────
# These are used by the "Seed" step to create login accounts.
# Run seed once after first deploy: node dist/scripts/seed.mjs
# 🔒 ✏️
ADMIN_PASSWORD=
OPERATOR_PASSWORD=


# ── CORS — your Vercel / custom frontend URL ──────────────
# ✏️  Replace with your actual frontend URL after first deploy
CORS_ORIGIN=https://your-app.vercel.app


# ── Business Info (shown on receipts & notifications) ─────
# ✏️  Change to your actual business details
BUSINESS_NAME=SAHU CSC Center
BUSINESS_ADDRESS=Main Road, Bargarh, Odisha 768028
ADMIN_MOBILE=9876543210
OPERATOR_MOBILE=9876543211
OPERATOR_EMAIL=operator@sahucsc.in


# ── Cache ─────────────────────────────────────────────────
CACHE_BACKEND=memory                       # ✅ no Redis needed on free tier


# ── Geo Access ────────────────────────────────────────────
# Render servers are in Singapore, not India — keep true
ALLOW_NON_INDIA=true                       # ✅


# ── 2FA ───────────────────────────────────────────────────
DISABLE_2FA=false                          # ✅ keep 2FA enabled in production


# ── Push Notifications ────────────────────────────────────
# Must be mailto: format
# 🔒 ✏️
VAPID_EMAIL=mailto:your-email@gmail.com

# Optional — auto-generated at first boot and saved to DB.
# Copy the value from DB settings table after first deploy
# so push subscriptions survive future re-deploys.
# 🔒 ✏️ (fill in after first deploy)
VAPID_PRIVATE_KEY=


# ── Encryption & JWT (auto-generated at first boot) ───────
# Leave blank on first deploy — the server generates and stores
# them in the DB. After first deploy, copy from DB settings table
# and set here so encrypted data survives future re-deploys.
# 🔒 ✏️ (fill in after first deploy)
ENCRYPTION_KEY=
JWT_SECRET=


# ── Email / SMTP (optional — for OTP & notifications) ─────
# Without these, emails are silently skipped (no crash).
SMTP_HOST=smtp.gmail.com                   # ✅
SMTP_PORT=587                              # ✅
# 🔒 ✏️
SMTP_USER=your-email@gmail.com
SMTP_FROM_EMAIL=SAHU CSC <your-email@gmail.com>
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx         # Gmail App Password, not login password


# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info                             # ✅  trace|debug|info|warn|error


# ══════════════════════════════════════════════════════════
#  OPTIONAL — uncomment only if you set these services up
# ══════════════════════════════════════════════════════════

# ── Backblaze B2 (avatar & backup cloud storage) ──────────
# Without these, avatars stay as base64 and backups are local only.
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET_NAME=sahu-csc-storage
# B2_BUCKET_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ── Upstash Redis (background jobs via BullMQ) ─────────────
# Must be TCP URL (rediss://...), not the REST URL.
# REDIS_URL=rediss://default:password@host:port
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Sentry Error Tracking ─────────────────────────────────
# SENTRY_DSN=

# ── MaxMind GeoIP (weekly auto-update) ────────────────────
# Free key at maxmind.com — needed if you turn off ALLOW_NON_INDIA
# MAXMIND_LICENSE_KEY=
