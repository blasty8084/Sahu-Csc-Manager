# SAHU CSC — Render Environment Variables (complete)
# Paste into: Render Dashboard → service → Environment

# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Database ──────────────────────────────────────────────
# From neon.tech → your project → Connection String
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Session ───────────────────────────────────────────────
# Generate: openssl rand -base64 48
SESSION_SECRET=your-long-random-secret-here

# ── Admin Accounts ────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password
OPERATOR_PASSWORD=your-operator-password

# ── Business Info ─────────────────────────────────────────
BUSINESS_NAME=SAHU CSC Center
BUSINESS_ADDRESS=Main Road, Bargarh, Odisha 768028
ADMIN_MOBILE=9876543210
OPERATOR_MOBILE=9876543211
OPERATOR_EMAIL=operator@sahucsc.in

# ── Frontend (CORS) ───────────────────────────────────────
# Your Vercel or custom frontend URL
CORS_ORIGIN=https://your-app.vercel.app

# ── Cache ─────────────────────────────────────────────────
CACHE_BACKEND=memory

# ── Geo ───────────────────────────────────────────────────
# Render servers are outside India — keep true
ALLOW_NON_INDIA=true

# ── 2FA ───────────────────────────────────────────────────
DISABLE_2FA=false

# ── Push Notifications ────────────────────────────────────
# Must start with mailto:
VAPID_EMAIL=mailto:your-email@gmail.com
# Auto-generated at first boot — copy from DB after first deploy
VAPID_PRIVATE_KEY=

# ── Encryption & JWT ──────────────────────────────────────
# Auto-generated at first boot — copy from DB after first deploy
# If left blank the server creates them; fill in on re-deploys
ENCRYPTION_KEY=
JWT_SECRET=

# ── Email / SMTP ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_FROM_EMAIL=SAHU CSC <your-email@gmail.com>
# Gmail App Password (Google Account → Security → App Passwords)
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── Backblaze B2 (cloud storage for avatars & backups) ────
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=sahu-csc-storage
B2_BUCKET_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ── Upstash Redis (background jobs via BullMQ) ─────────────
# TCP URL — rediss://default:password@host:port
REDIS_URL=
# REST URL — https://xxx.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GeoIP Updates (weekly auto-update via MaxMind) ─────────
# Free key at maxmind.com — lets you disable ALLOW_NON_INDIA
MAXMIND_LICENSE_KEY=

# ── Sentry Error Tracking ─────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── DB Pool ───────────────────────────────────────────────
DB_POOL_MAX=10
